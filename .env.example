# --- Supabase project (Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-keep-secret>

# --- Database (Settings -> Database -> Connection string -> Transaction pooler, port 6543) ---
# Admin connection, user postgres.<project-ref>
DATABASE_URL_ADMIN=postgresql://postgres.<project-ref>:[YOUR-DB-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres
# Same host, but the restricted qp_query role, user qp_query.<project-ref> (used from next weekend)
DATABASE_URL_QUERY=postgresql://qp_query.<project-ref>:[QP-QUERY-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres
# Password for the qp_query role; used only by the migrate script to create/rotate the role
QP_QUERY_PASSWORD=<generate-a-strong-password>

# --- OpenRouter ---
OPENROUTER_API_KEY=<openrouter-api-key>
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_FALLBACK_MODEL=openai/gpt-3.5-turbo

# Temporary gate on uploads until Google auth lands next weekend
UPLOAD_PASSPHRASE=<choose-a-passphrase>
